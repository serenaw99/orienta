# Copy these entries into .env.local at the repository root (ignored by Git).
# Never commit your real API key. The exp:004 command loads .env.local using Node 24.
GROQ_API_KEY=
# Use the same tool-capable model in every matched condition. Availability depends
# on your Groq account; there is no automatic model substitution.
GROQ_MODEL=qwen/qwen3.8-27b
